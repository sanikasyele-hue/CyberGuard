# You do NOT need this file to run locally from Eclipse - defaults already work.
# Use these as environment variables when you DEPLOY (never commit real values).

DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Base64 string of at least 32 bytes. Generate: openssl rand -base64 32
# (If empty, a random key is made on every start and logins reset on restart.)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# First admin account (created automatically if missing). CHANGE the password.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=choose_a_strong_password
SEED_ADMIN_ENABLED=true

# AI agents. Leave the key empty to use the built-in offline rules.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_AUTO_ANALYZE=true

# Detection rules (defaults shown)
FAILED_LOGIN_THRESHOLD=5
DETECTION_WINDOW_MINUTES=10
COMPROMISE_MIN_FAILURES=5
SPRAY_MIN_ATTEMPTS=6
SPRAY_MIN_USERS=3

# Machine-learning model
ML_ENABLED=true
ML_THRESHOLD=0.8
